# ===== 律析 · 环境变量模板 =====
# 复制本文件为 .env.local 并填入真实值
# 注意：本项目为纯静态部署，密钥使用 NEXT_PUBLIC_ 前缀，
# 会在构建时内联进前端代码（任何拿到网页的人都能看到）。
# 赛后请到 platform.deepseek.com 重置密钥即可作废。

# DeepSeek API 密钥（https://platform.deepseek.com 获取）
NEXT_PUBLIC_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 接口地址（OpenAI 兼容）
NEXT_PUBLIC_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型
NEXT_PUBLIC_DEEPSEEK_MODEL=deepseek-chat
